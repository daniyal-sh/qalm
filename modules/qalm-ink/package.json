{
  "name": "qalm-ink",
  "version": "0.1.0",
  "private": true,
  "description": "qalm ink surface: Skia PageCanvas, low-latency InkOverlay, and PDF page rendering",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "gen:fixture": "esbuild scripts/gen-freehand-fixture.ts --bundle --platform=node --outfile=android/build/gen-fixture.cjs --log-level=warning && node android/build/gen-fixture.cjs"
  },
  "dependencies": {
    "@qalm/core": "workspace:*",
    "@shopify/react-native-skia": "2.14.0",
    "pdfjs-dist": "6.5.438",
    "perfect-freehand": "1.2.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "typescript": "~6.0.3"
  }
}
