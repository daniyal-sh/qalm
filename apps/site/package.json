{
  "name": "@qalm/site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:landing": "node landing/build.mjs",
    "build:og": "node landing/og.mjs",
    "build:site": "node scripts/build.mjs",
    "preview": "wrangler dev --port 8790",
    "deploy:staging": "node scripts/build.mjs && wrangler deploy --env staging",
    "deploy:prod": "node scripts/build.mjs && wrangler deploy --env production",
    "test": "node --test test/worker.test.mjs",
    "showcase": "node showcase/capture.mjs",
    "showcase:frame": "node showcase/frame.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "perfect-freehand": "^1.2.3",
    "playwright-core": "1.65.1",
    "sharp": "^0.35.5",
    "wrangler": "^4.166.0"
  }
}
