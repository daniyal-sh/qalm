{
  "expo": {
    "name": "qalm",
    "slug": "qalm",
    "version": "0.1.0",
    "scheme": "qalm",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f3f3f5",
    "ios": {
      "bundleIdentifier": "com.apollo.qalm",
      "supportsTablet": true,
      "requireFullScreen": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.apollo.qalm",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "qalm",
      "shortName": "qalm",
      "themeColor": "#f3f3f5",
      "backgroundColor": "#f3f3f5"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        { "photosPermission": "qalm uses your photos when you insert an image on a page." }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
