// qalm web app (the Expo web export in ./dist), served as static assets from a Worker.
// Staging: EXPO_PUBLIC_QALM_SERVER_URL=https://qalm-api-staging.apollolearn.workers.dev pnpm --filter @qalm/app deploy:staging
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qalm-web",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": {
      "name": "qalm-web-staging",
      "workers_dev": true
    }
  }
}
