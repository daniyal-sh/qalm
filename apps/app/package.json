{
  "name": "@qalm/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/web-assets.mjs && expo start --web",
    "export:web": "node scripts/web-assets.mjs && expo export -p web",
    "web-assets": "node scripts/web-assets.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "bench:micro": "vitest run --config scripts/bench/vitest.micro.mts",
    "bench": "node scripts/bench/run.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@qalm/core": "workspace:*",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lib0": "^0.2.120",
    "pdf-lib": "^1.17.1",
    "qalm-ink": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~6.0.3",
