{
  "name": "@qalm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "migrate:local": "wrangler d1 migrations apply qalm --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "wrangler deploy --env staging",
    "migrate:staging": "wrangler d1 migrations apply qalm-staging --remote --env staging"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@qalm/core": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "jose": "^6.2.18",
    "lib0": "^0.2.120",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261119.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
