// qalm server. The top-level ids are placeholders for local dev; staging and production are configured below.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qalm-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qalm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "qalm-assets" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "vars": {
    "EMAIL_PROVIDER": "console",
    // App sign-in links in emails open the web app's verify route, which POSTs the token back (see .dev.vars.example).
    "MAGIC_LINK_URL": "https://qalm.apollolearn.app/app/auth/email/verify",
    // Per-user storage cap in bytes: uploaded PDFs and images plus notebook data (250 MB in the free beta).
    "MAX_USER_STORAGE_BYTES": "250000000"
  },
  "observability": { "enabled": true },

  // Staging on workers.dev (deploy: pnpm --filter @qalm/server deploy:staging). Bindings aren't inherited, so
  // they're repeated here with the staging resources.
  "env": {
    "staging": {
      "name": "qalm-api-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qalm-staging",
          "database_id": "d500d939-6223-4ec1-845e-d04201b654ab",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "qalm-assets-staging" }],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "42a58f320e4e442790c98aa0e1d1e241" }],
      "vars": {
        "PUBLIC_URL": "https://qalm-api-staging.apollolearn.workers.dev",
        "MAGIC_LINK_URL": "https://qalm-web-staging.apollolearn.workers.dev/app/auth/email/verify",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "qalm <qalm@apollolearn.app>",
        "MAX_USER_STORAGE_BYTES": "250000000"
      },
      "observability": { "enabled": true }
    },

    // Production on https://qalm-api.apollolearn.app (deploy: pnpm --filter @qalm/server deploy:prod). The web app is
    // on https://qalm.apollolearn.app/app (apps/site). Resources created 2026-11-24 (handover.md §7).
    "production": {
      "name": "qalm-api",
      "workers_dev": false,
      "routes": [{ "pattern": "qalm-api.apollolearn.app", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qalm-prod",
          "database_id": "26805932-7d5f-4c6d-896b-d5784c2ade0d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "qalm-assets-prod" }],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "f4718837af774fc483d2ac67f108abdb" }],
      "vars": {
        "PUBLIC_URL": "https://qalm-api.apollolearn.app",
        "MAGIC_LINK_URL": "https://qalm.apollolearn.app/app/auth/email/verify",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "qalm <qalm@apollolearn.app>",
        "MAX_USER_STORAGE_BYTES": "250000000"
      },
      "observability": { "enabled": true }
    }
  }
}
